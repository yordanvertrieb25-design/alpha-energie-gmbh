// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model PartnerApplication {
  id               Int      @id @default(autoincrement())
  fullName         String
  email            String
  phone            String
  experience       String
  notes            String?
  
  // --- Stammdaten ---
  salutation       String?
  firstName        String?
  lastName         String?
  birthDate        String?
  
  // --- Adresse ---
  street           String?
  houseNr          String?
  plz              String?
  city             String?
  country          String? @default("Deutschland")
  
  // --- Unternehmen ---
  isVatLiable      Boolean? @default(false)
  companyName      String?
  legalForm        String?
  taxId            String?
  taxOffice        String?
  
  // --- Bankverbindung ---
  iban             String?
  bic              String?
  bankName         String?
  
  // --- Kontakt / Uploads ---
  website          String?
  tradeLicenseUrl  String?
  idCardFrontUrl   String?
  idCardBackUrl    String?
  masterDataStatus      String?   @default("PENDING") // PENDING, SUBMITTED
  masterDataEmailSent   Boolean?  @default(false)
  masterDataEmailSentAt DateTime?
  
  createdAt        DateTime @default(now())
  
  // --- Affiliate ---
  affiliateLinkId  Int?
  affiliateLink    AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
}

model Appointment {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  date      String   
  time      String   
  createdAt DateTime @default(now())
}

model Campaign {
  id          Int              @id @default(autoincrement())
  name        String
  industry    String
  companySize String
  status      String           @default("RUNNING") // RUNNING, COMPLETED, FAILED
  createdAt   DateTime         @default(now())
  contacts    ScrapedContact[]
}

model ScrapedContact {
  id         Int        @id @default(autoincrement())
  campaignId Int
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  website    String?
  email      String?
  address    String?
  status     String     @default("PENDING") // PENDING, SENT, FAILED
  createdAt  DateTime   @default(now())
  emailLogs  EmailLog[]
}

model EmailLog {
  id               Int            @id @default(autoincrement())
  scrapedContactId Int
  scrapedContact   ScrapedContact @relation(fields: [scrapedContactId], references: [id], onDelete: Cascade)
  sentAt           DateTime       @default(now())
  status           String         // SUCCESS, FAILED
  errorMessage     String?
  subject          String
  body             String
}

model AffiliateLink {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  name             String
  clicks           Int                  @default(0)
  createdAt        DateTime             @default(now())
  applications     PartnerApplication[]
}

model EnergyOrder {
  id                 Int          @id @default(autoincrement())
  orderNumber        String       @unique
  tariffId           String
  tariffName         String
  branch             String       @default("strom")
  consumption        Int
  monthlyPayment     Float
  savings            Float?
  
  street             String
  houseNr            String
  plz                String
  city               String
  meterNumber        String
  currentProvider    String?
  cancelOldContract  Boolean      @default(true)
  
  salutation         String?
  firstName          String
  lastName           String
  birthDate          String?
  email              String
  phone              String
  iban               String
  
  status             String       @default("RECEIVED")
  createdAt          DateTime     @default(now())

  // --- Partner & Commission & eSign Fields ---
  partnerId          Int?
  partner            PartnerUser? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerCode        String?
  subId              String?
  orderSource        String?      @default("ONLINE") // ONLINE, AFFILIATE, D2D, REMOTE_SIGN, TIPPGEBER, B2B
  commissionStatus   String?      @default("NONE")   // NONE, PENDING, APPROVED, PAID, CANCELLED
  commissionAmount   Float?       @default(0)
  overridePartnerId  Int?
  overrideAmount     Float?       @default(0)
  signatureData      String?
  signatureToken     String?      @unique
  signedAt           DateTime?
  remoteSignToken    String?
  firstconContractId String?
  ibanValid          Boolean?
  bankName           String?
  bic                String?
  notes              String?
}

model PartnerUser {
  id                     Int                @id @default(autoincrement())
  email                  String             @unique
  passwordHash           String
  fullName               String
  salutation             String?            @default("Herr")
  firstName              String?
  lastName               String?
  phone                  String?
  birthDate              String?
  companyName            String?
  legalForm              String?
  website                String?
  partnerCode            String             @unique
  role                   String             @default("D2D") // D2D, AFFILIATE, TIPPGEBER, AGENCY
  status                 String             @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  commissionTier         String             @default("PRO") // STARTER, PRO, ELITE
  stromCommissionEur     Float              @default(55.0)
  gasCommissionEur       Float              @default(55.0)
  waermeCommissionEur    Float              @default(65.0)
  tippgeberCommissionEur Float              @default(35.0)
  b2bCommissionPct       Float              @default(15.0)
  overrideCommissionEur  Float              @default(10.0)

  // --- Downline / Agency Hierarchy ---
  parentPartnerId        Int?
  parentPartner          PartnerUser?       @relation("PartnerDownline", fields: [parentPartnerId], references: [id], onDelete: SetNull)
  subPartners            PartnerUser[]      @relation("PartnerDownline")

  // --- Address, Tax & Bank ---
  street                 String?
  houseNr                String?
  plz                    String?
  city                   String?
  country                String?            @default("Deutschland")
  isVatLiable            Boolean            @default(false)
  taxId                  String?
  taxOffice              String?
  iban                   String?
  bic                    String?
  bankName               String?
  firstconToken          String?
  partnerApplicationId   Int?
  applicationId          Int?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  orders                 EnergyOrder[]
  leads                  PartnerLead[]
  clicks                 AffiliateClick[]
  payouts                CommissionPayout[]
}

model PartnerLead {
  id                   Int          @id @default(autoincrement())
  partnerId            Int?
  partner              PartnerUser? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerCode          String
  leadType             String       @default("TIPPGEBER")
  salutation           String?
  firstName            String?
  lastName             String?
  customerName         String
  companyName          String?
  email                String?
  customerEmail        String?
  phone                String?
  customerPhone        String?
  street               String?
  houseNr              String?
  plz                  String?
  city                 String?
  branch               String       @default("strom")
  consumption          Int?         @default(2500)
  estimatedConsumption Int?
  currentProvider      String?
  meterNumber          String?
  notes                String?
  status               String       @default("NEW")
  expectedCommission   Float        @default(35.0)
  commissionAmount     Float        @default(35.0)
  convertedOrderId     Int?
  convertedOrderNo     String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model AffiliateClick {
  id          Int          @id @default(autoincrement())
  partnerId   Int?
  partner     PartnerUser? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerCode String
  subId       String?
  targetPage  String?
  landingPage String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  converted   Boolean      @default(false)
  orderNumber String?
  createdAt   DateTime     @default(now())
}

model CommissionPayout {
  id           Int         @id @default(autoincrement())
  payoutNumber String      @unique
  partnerId    Int
  partner      PartnerUser @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  period       String      @default("2026")
  periodLabel  String      @default("Laufende Abrechnung")
  ordersCount  Int         @default(0)
  netAmount    Float       @default(0)
  vatAmount    Float       @default(0)
  grossAmount  Float       @default(0)
  status       String      @default("PENDING") // PENDING, APPROVED, PAID
  iban         String?
  bic          String?
  bankName     String?
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
}

model MeterReading {
  id           Int      @id @default(autoincrement())
  meterNumber  String
  reading      Float
  readingDate  String
  customerName String
  email        String
  notes        String?
  createdAt    DateTime @default(now())
}

model LegalCancellation {
  id             Int      @id @default(autoincrement())
  contractNumber String
  customerName   String
  email          String
  cancelDate     String?
  reason         String?
  type           String   @default("KUENDIGUNG")
  createdAt      DateTime @default(now())
}
